# TFX AI - Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
APP_NAME=TFX AI
APP_ENV=development
APP_PORT=8000
CLIENT_URL=http://localhost:3000
SECRET_KEY=your-super-secret-key-change-in-production

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL/NeonDB Database URL
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_Gd74AmkTZqcn@ep-red-brook-a812s3fi-pooler.eastus2.azure.neon.tech/neondb

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Configuration
PASSWORD_MIN_LENGTH=8

# ===========================================
# EMAIL SERVICE CONFIGURATION
# ===========================================
# SMTP Settings (Gmail example)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ===========================================
# AI SERVICES CONFIGURATION
# ===========================================
# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================
# Rate limiting settings
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
# Google Analytics (Optional)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Sentry Error Tracking (Optional)
SENTRY_DSN=your-sentry-dsn

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# Next.js Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=GA-XXXXXXXXX

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Development settings
DEBUG=True
TESTING=False

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================
# Production settings (uncomment for production)
# APP_ENV=production
# DEBUG=False
# LOG_LEVEL=WARNING
# SSL_MODE=require

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
# Database backup settings
BACKUP_ENABLED=False
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# ===========================================
# SECURITY HEADERS
# ===========================================
# Security headers configuration
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
